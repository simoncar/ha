                  "heading_style": "subtitle",
                  "icon": "mdi:air-conditioner",
                  "badges": [
                    {
                      "type": "button",
                      "text": "On",
                      "icon": "mdi:fan",
                      "color": "cyan",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "script.air_con_on"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "text": "Off",
                      "icon": "mdi:fan-off",
                      "color": "grey",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "script.air_con_off"
                        }
                      }
                    }
                  ],
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "column_span": 1,
              "background": {
                "color": "#d99b36",
                "opacity": 8
