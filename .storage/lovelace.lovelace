              "content": "# {% if now().hour < 12 %}Good morning{% elif now().hour < 18 %}Good afternoon{% else %}Good evening{% endif %}, {{ user }}\n**{{ states('input_select.home_mode') }} mode** · Family room {{ states('sensor.family_room_temperature') }} {{ state_attr('sensor.family_room_temperature', 'unit_of_measurement') or '°C' }}"
            }
          },
          "badges": [
            {
              "type": "entity",
              "entity": "input_select.home_mode",
              "name": "Mode",
              "show_name": true,
              "show_state": true,
              "icon": "mdi:home-switch",
              "color": "accent"
            },
            {
              "type": "entity",
              "entity": "sensor.family_room_temperature",
              "name": "Family room",
              "show_name": true,
              "show_state": true,
              "color": "state"
            },
            {
              "type": "entity",
              "entity": "weather.gracia",
              "show_name": false,
              "show_state": true,
              "color": "state"
            }
          ],
          "sections": [
            {
              "type": "grid",
              "column_span": 1,
              "background": {
                "color": "#56718c",
                "opacity": 8
              },
              "cards": [
                {
                  "type": "heading",
                  "heading": "Home mode",
                  "icon": "mdi:home-switch",
                  "badges": [
                    {
                      "type": "entity",
                      "entity": "input_select.home_mode",
                      "show_icon": false,
                      "show_state": true
                    },
                    {
                      "type": "button",
                      "text": "Away",
                      "icon": "mdi:bag-suitcase",
                      "color": "blue",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "input_select.select_option",
                        "target": {
                          "entity_id": "input_select.home_mode"
                        },
                        "data": {
                          "option": "Away"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "text": "Normal",
                      "icon": "mdi:home",
                      "color": "green",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "input_select.select_option",
                        "target": {
                          "entity_id": "input_select.home_mode"
                        },
                        "data": {
                          "option": "Normal"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "text": "Dark",
                      "icon": "mdi:candle",
                      "color": "deep-purple",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "input_select.select_option",
                        "target": {
                          "entity_id": "input_select.home_mode"
                        },
                        "data": {
                          "option": "Dark"
                        }
                      }
                    }
                  ],
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
                  "type": "heading",
                  "heading": "Blinds",
                  "heading_style": "subtitle",
                  "icon": "mdi:blinds",
                  "badges": [
                    {
                      "type": "button",
                      "text": "Down",
                      "icon": "mdi:arrow-down",
                      "color": "blue-grey",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "script.blinds_down"
                        }
                      }
                    },
                    {
                      "type": "button",
                      "text": "Up",
                      "icon": "mdi:arrow-up",
                      "color": "blue-grey",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.turn_on",
                        "target": {
                          "entity_id": "script.blinds_up"
                        }
                      }
                    }
                  ],
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
